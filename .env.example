# Copy to .env and fill in. Never commit .env.

# --- Server ---
SERVER_PORT=8787
SERVER_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
# Public HTTPS URL of this server (deployment or tunnel). Agora's engine calls the tools here.
PUBLIC_BASE_URL=
# mcp (default) or http
TOOL_TRANSPORT=mcp

# --- Agora (console.agora.io) ---
# App ID + App Certificate are all the voice agent needs (project must have the certificate enabled).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional RESTful API credentials (Customer ID / Customer Secret); not used by the voice agent.
# Real-Time STT (consult transcription, CONSULT_STT=agora) needs them; without them it falls back to OpenAI.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Agent REST region: US | EU | AP | CN
AGORA_AREA=AP
# 1 logs the redacted agent start request on the server
AGORA_DEBUG=0

# --- Voice agent tuning ---
# Browser and agent token lifetime, seconds from now (max 86400)
VOICE_TOKEN_TTL_SEC=7200
# Seconds the agent stays after the buyer leaves the channel
AGENT_IDLE_TIMEOUT_SEC=120
# Conversation turns the engine keeps for the model
AGENT_MAX_HISTORY=24
# Per tool call timeout in ms; leave empty for the tools default (slowest tool + 2 s)
MCP_TIMEOUT_MS=
# A filler phrase plays only when a reply takes longer than this. Keep it high (10000): fillers clipped the start of replies after tool calls in live tests.
FILLER_WAIT_MS=10000

# --- OpenAI ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional: none | low | medium | high, sent as llm.params.reasoning_effort.
# Reasoning models (e.g. gpt-6-luna, gpt-5.6-luna) need "none" to call tools on /v1/chat/completions.
LLM_REASONING_EFFORT=
REPORT_MODEL=gpt-4.1-mini

# --- Murf (murf.ai API) ---
MURF_API_KEY=
# Full Murf voice id, e.g. en-IN-anusha, en-IN-pooja (female) or en-IN-nikhil, en-IN-samar, en-IN-aarav (male). List: GET https://api.murf.ai/v1/speech/voices?model=falcon-2.1
MURF_VOICE_ID=en-IN-anusha
MURF_LOCALE=en-IN
# Global router (2 concurrent calls outside US-East); wss://us-east.api.murf.ai/v1/speech/stream-input allows 5
MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input
MURF_RATE=0
MURF_PITCH=0

# --- Speech recognition (vendor supported by Agora) ---
# ares (default; keyword boosting, no key) | openai (reuses OPENAI_API_KEY) | deepgram (nova-3, needs ASR_API_KEY) | sarvam (needs ASR_API_KEY)
ASR_VENDOR=ares
ASR_LANGUAGE=en-IN
ASR_API_KEY=
# off sends no recognition keywords (use to isolate recognition problems)
ASR_KEYWORDS=on
# Transcription model when ASR_VENDOR=openai
ASR_OPENAI_MODEL=gpt-4o-mini-transcribe

# Name the AI advisor introduces itself with
ADVISOR_NAME=Asha

# --- Reports ---
# none | resend | smtp
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
SMTP_URL=
# none | twilio | meta | preview (composes every message and shows it on the Lead Desk without sending)
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Buyer replies (optional): set the Twilio sandbox "When a message comes in" to
# ${PUBLIC_BASE_URL}/api/integrations/whatsapp/inbound (POST). Checked with TWILIO_AUTH_TOKEN.
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# --- Optional CRM sync ---
HUBSPOT_TOKEN=

# --- Slack (team alerts; threads per lead) -----------------------------
# Bot token with chat:write, invited to the channel (/invite @app in the channel). SLACK_CHANNEL_ID is
# the C... id from the channel's details. SLACK_WEBHOOK_URL is a fallback without threads.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_CHANNEL_NAME="#sales-pipeline"
SLACK_WEBHOOK_URL=

# --- Jira Cloud (follow-up tasks) --------------------------------------
# Site URL, the Atlassian account email, an API token from id.atlassian.com, and the project key.
# If the project has no due date or labels on its create screen, issues are created without them.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_LABEL=virtual-estates

# --- Pipeline and consult ----------------------------------------------
# Channels the automatic pipeline may use. Manual sends from the Desk are not limited by this.
AUTOMATIONS=whatsapp,email,slack,jira,crm
# How long a buyer waits for a human before the AI offers a call back (ms).
HANDOFF_TIMEOUT_MS=90000
# Transcription while a human advisor is on the call: agora (Real-Time STT, enable it in Agora Console), openai, or off.
CONSULT_STT=agora
CONSULT_MODEL=gpt-4.1-mini

# --- Web (exposed to the browser; never put secrets here) ---
# human3d (3D talking head, falls back to the mascot) | mascot
VITE_AVATAR_MODE=human3d
# Optional override for the avatar GLB (default /avatar/mpfb.opt.glb, falling back to /avatar/mpfb.glb)
VITE_AVATAR_URL=
VITE_MAP_TILES_KEY=

# --- Maps (live custom routes for the advisor) ---
# off disables live geocoding/routing (presets still work)
MAPS_LIVE_ROUTES=
# Defaults: public Nominatim and OSRM demo servers (respect their usage policies)
MAPS_GEOCODER_URL=
MAPS_ROUTER_URL=
# Identifying User-Agent for Nominatim/OSRM, e.g. "AgoraVirtualEstates/0.1 (contact@example.com)"
MAPS_USER_AGENT=
# M or F; Avaturn files carry no body form (default F)
VITE_AVATAR_BODY=
